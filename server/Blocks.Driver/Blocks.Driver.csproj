<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Version>10.0.0-preview.1</Version>
		<PackageId>SeliseBlocks.Driver</PackageId>
		<Authors>SeliseBlocks</Authors>
		<Company>SeliseBlocks</Company>
		<Description>Unified Blocks driver exposing Captcha, MFA, Identifier, IAM, Storage, Language and Monitor operations through dedicated interfaces.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>Genesis, BlocksGenesis, SeliseBlocksGenesis, Captcha, Mfa, Identifier, Iam, Storage, Language, Monitor, Driver</PackageTags>
		<RepositoryUrl>https://github.com/SELISEdigitalplatforms/blocks-logic</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<!-- Captcha.Driver/Iam.Driver/Mfa.Driver on disk still target net9.0 with non-CPM package
		     versions and are excluded from Blocks.slnx, so they don't build against this net10.0
		     solution. Blocks.Driver wraps the same DomainService projects they wrap instead, so
		     the existing driver packages are left untouched. -->
		<ProjectReference Include="../Common.InternalService/Common.InternalService.csproj" PrivateAssets="All" />
		<None Include="$(OutputPath)Captcha.DomainService.dll" Pack="true" PackagePath="lib/$(TargetFramework)/" />
		<None Include="$(OutputPath)Iam.DomainService.dll" Pack="true" PackagePath="lib/$(TargetFramework)/" />
		<None Include="$(OutputPath)Mfa.DomainService.dll" Pack="true" PackagePath="lib/$(TargetFramework)/" />
		<None Include="$(OutputPath)Common.InternalService.dll" Pack="true" PackagePath="lib/$(TargetFramework)/" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SeliseBlocks.Genesis.OS" />
	</ItemGroup>

</Project>
