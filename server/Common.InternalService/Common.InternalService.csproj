<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Access/ validates inbound Blocks bearer tokens for endpoints whose access policy is stored per row,
      which needs HttpRequest and the token helpers, so the project takes a FrameworkReference on the
      shared framework exactly as the Proxy domain does.
    -->
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation" />
        <PackageReference Include="Newtonsoft.Json" />
        <PackageReference Include="SeliseBlocks.Genesis.OS" />
        <PackageReference Include="MongoDB.Driver" />
        <PackageReference Include="Azure.Storage.Blobs" />
        <PackageReference Include="AWSSDK.S3" />
        <PackageReference Include="SSH.NET" />
        <!-- The shared read-only secret catalog (Secret/) wraps the in-process ISecretService. -->
        <PackageReference Include="SeliseBlocks.Secrets.OS" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\CloudConfiguration.DomainService\CloudConfiguration.DomainService.csproj" />
      <PackageReference Include="SeliseBlocks.StorageDriver.OS" />
    </ItemGroup>

</Project>
