{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "SwaggerOptions": {
    "Version": "v1",
    "Title": "Blocks Logic API",
    "Description": "Blocks Logic API documentation",
    "XmlCommentsFilePath": "Api.xml",
    "EndpointUrl": "/swagger/v1/swagger.json",
    "EnableBearerAuth": true,
    "ServiceName": "blocks-logic"
  },
  "SecretManager": {
    "SecretManagerType": "OnPrem",
    "SecretManagerPath": "x"
  },

  "FrontendRuntime": {
    "BLOCKS_API_BASE_URL": "http://localhost:5000",
    "BLOCKS_X_BLOCKS_KEY": "***REMOVED***",
    "BLOCKS_GOOGLE_SITE_KEY": "***REMOVED***",
    "BLOCKS_CONSTRUCT_URL": "https://dev-construct.seliseblocks.com"
  }
}
