<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="JUnitLogger" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="SeliseBlocks.Genesis.OS" />
    <!--
      SeliseBlocks.EurolmDriver.OS (transitive, via Api) still depends on the legacy
      "SeliseBlocks.Genesis" package (not yet migrated to "SeliseBlocks.Genesis.OS"). Both
      ship an assembly named Blocks.Genesis.dll; MSBuild's reference conflict resolution
      picks the higher assembly version (10.1.7.0) over the newer, actively-developed
      SeliseBlocks.Genesis.OS 4.0.8 assembly (4.0.8.0), which silently hides newer APIs
      (e.g. the Delegation feature) from every test here. Exclude its compile/runtime
      assets so SeliseBlocks.Genesis.OS's assembly is the only one on the reference list.
    -->
    <PackageReference Include="SeliseBlocks.Genesis" VersionOverride="10.1.7" ExcludeAssets="compile;runtime" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\Api\Api.csproj" />
	<ProjectReference Include="..\Iam.DomainService\Iam.DomainService.csproj" />
	<ProjectReference Include="..\Mfa.DomainService\Mfa.DomainService.csproj" />
	<ProjectReference Include="..\Worker\Worker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Resources\Validators\" />
  </ItemGroup>

  <!--
    SeliseBlocks.MonitorDriver.OS (pulled in transitively through Api) ships
    Alert.DomainService.dll, which declares types under the same fully-qualified
    names as this solution's own DomainService, notably
    DomainService.Shared.Services.IHttpHelperServices. Nothing in the tests uses the
    vendored copies, but their presence makes the local names ambiguous and blocks
    any test that needs to mock one. Putting the vendored assembly behind an extern
    alias hides it unless a file asks for it by name. See issue #181.
  -->
  <Target Name="HideVendoredDomainServiceTypes" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferencePath Condition="'%(FileName)' == 'Alert.DomainService'">
        <Aliases>vendored</Aliases>
      </ReferencePath>
    </ItemGroup>
  </Target>

</Project>
