# syntax=docker/dockerfile:1
# =============================================================================
# Blocks Logic Scheduler.Worker: Hangfire + schedule registry consumers (no HTTP host).
# Run exactly ONE replica: every replica fires every schedule.
# Build: docker build -f Dockerfile.scheduler -t blocks-logic-scheduler-worker .
# =============================================================================

ARG DOTNET_PUBLISH_PLATFORM=linux/amd64

# -----------------------------------------------------------------------------
# Stage: publish: .NET SDK (glibc). Default platform linux/amd64 avoids Grpc.Tools
# protoc crashes on some arm64 build hosts; override if your CI publishes safely
# on arm64: docker build --build-arg DOTNET_PUBLISH_PLATFORM=linux/arm64 .
# -----------------------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS publish
WORKDIR /src

COPY server ./server

RUN dotnet publish server/Scheduler.Worker/Scheduler.Worker.csproj \
    -c Release \
    -o /app/publish \
    --no-self-contained \
    -p:DebugType=None

# -----------------------------------------------------------------------------
# Stage: runtime: ASP.NET Core runtime on Alpine (Scheduler.Worker targets shared
# Microsoft.AspNetCore.App via the Worker SDK / dependencies.)
# -----------------------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS final

ARG BUILD_VERSION=0.0.0
LABEL org.opencontainers.image.title="blocks-logic-scheduler-worker" \
    org.opencontainers.image.description="Blocks Logic scheduler worker (Generic Host, Hangfire, schedule registry consumers). One replica only." \
    org.opencontainers.image.version="${BUILD_VERSION}"

WORKDIR /app

ENV DOTNET_ENVIRONMENT=Production \
    DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false

# tzdata backs TimeZoneInfo (IANA ids); Alpine ships without it.
RUN apk add --no-cache icu-libs tzdata

COPY --from=publish /app/publish .
RUN chown -R app:app /app

USER app

ENTRYPOINT ["dotnet", "Scheduler.Worker.dll"]
