<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Blocks.FunctionRunner.Tests</RootNamespace>
    <!-- Underscored test names are the xUnit convention and read as sentences; the rule is
         about public API surface, which a test assembly does not have. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="Docker.DotNet" />
    <PackageReference Include="SharpZipLib" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Blocks.FunctionRunner/Blocks.FunctionRunner.csproj" />
    <ProjectReference Include="../Blocks.FunctionRunner.Contracts/Blocks.FunctionRunner.Contracts.csproj" />
  </ItemGroup>
</Project>
