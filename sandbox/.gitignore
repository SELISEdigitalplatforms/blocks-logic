# Build output
bin/
obj/

# Written by provision/00-preflight.sh on each host: that machine's kernel, CPU, disk and
# primary IP. Regenerated by `make` on whatever host runs it, so committing one host's copy
# would both be wrong elsewhere and publish this VM's address.
provision/.facts

# Run output from provisioning.
provision.log
*.log

# The real environment file lives at /etc/blocks-runner/runner.env, outside this tree, and
# holds the only credentials on the VM. Only the example belongs in git.
runner.env

# Local editor / OS noise
.vs/
.vscode/
.idea/
*.user
*.swp
*~
.DS_Store

# `dotnet test` output when run with a logger.
TestResults/

# lib.sh's write_file() keeps a timestamped copy of whatever it replaces. Those land in
# /etc on a real host, but land here whenever a script is pointed at the tree in testing.
*.bak.[0-9]*
