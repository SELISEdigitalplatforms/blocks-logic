# Reference for /etc/blocks-runner/runner.env — every variable the runner reads, with
# the Azure Key Vault and OnPrem paths side by side.
#
# This file does NOT seed anything. provision/40-runner-user.sh creates the real
# runner.env on a fresh host, and it is the template that actually runs; this one is
# documentation. Keep the two in step — they drifted once already (Runner__ here versus
# RUNNER__ everywhere else, which deploy.sh's gate matches case-sensitively).
# This file holds the only credentials on the Runner VM. It is never bind-mounted into a
# sandbox: the sandbox environment is a four-entry allowlist built in SandboxProfile.

# --- Genesis bootstrap ---------------------------------------------------------
# 1 = OnPrem (read the secrets below from this file), 2 = Azure Key Vault.
BLOCKS_VAULT_TYPE=1
DOTNET_ENVIRONMENT=Production

BlocksSecret__ServiceName=blocks-function-runner
BlocksSecret__CacheConnectionString=redis-host:6379,password=…,ssl=True
BlocksSecret__DatabaseConnectionString=mongodb://…
BlocksSecret__RootDatabaseName=blocks_root
BlocksSecret__LogConnectionString=mongodb://…
BlocksSecret__LogDatabaseName=blocks_logs

# Genesis validates delegated access at startup even for workers that never call IAM.
# Point this at IAM's internal address, never the public host.
BLOCKS_IAM_BASE_URL=http://blocks-iam.internal

# --- Runner identity and paths -------------------------------------------------
RUNNER__RunnerId=
RUNNER__RunsDir=/var/lib/blocks-runner/runs
RUNNER__BuildsDir=/var/lib/blocks-runner/builds
# One registry per host. Correct for a single-host install and wrong the moment there are two:
# an image built on host A does not exist on host B, so every host rebuilds everything, and each
# one reclaims blobs the others may still want.
#
# For a fleet, point every runner at one registry instead:
#
#   RUNNER__Registry=registry.internal:5000
#   RUNNER__RegistryUsername=blocks-runner
#   RUNNER__RegistryPassword=…            # admin API only; push and pull use dockerd's own auth
#
# TLS and registry pruning both follow the address unless you say otherwise — a loopback address
# means plain HTTP and "this host owns the blobs", anything else means HTTPS and "hands off":
#
#   RUNNER__RegistryTls=true|false
#   RUNNER__PruneRegistry=true|false
#
# Hands off is the safe default and worth understanding before overriding. Image GC decides an
# image is unused from *this host's* container list. On a shared registry that is one host's view,
# and an image no deployed version pins — a Test build — is protected by nothing else, so a host
# deleting it can take it out from under a run in progress somewhere else. Reclaiming a shared
# registry is one owner's job: either nominate a single runner with RUNNER__PruneRegistry=true,
# or leave it to the registry's own garbage collection and leave every runner on the default.
#
# Whichever registry it is, it needs REGISTRY_STORAGE_DELETE_ENABLED for deletes to do anything;
# without it the runner logs the refusal once and stops trying.
RUNNER__Registry=127.0.0.1:5000
# deploy.sh writes this line itself, pinned to the digest of the runtime image it just
# published, and rewrites it on every redeploy — but only while it names this host's own
# runtime repository. Point it somewhere else and deploy.sh leaves it alone and says so.
# A tag here is legal and mutable: the next build.sh moves it, and what tenant images are
# FROM changes under them.
RUNNER__BaseImage=127.0.0.1:5000/blocks/functions-node@sha256:…
RUNNER__Network=blocks-fn-egress
RUNNER__ResolvConf=/etc/blocks-runner/resolv.conf
# Not a tuning knob. Anything but runsc and the runner claims no work at all — deploy.sh,
# fnctl doctor and the startup guard each refuse it, and the sandbox profile ignores it in
# favour of the compiled-in constant.
RUNNER__Runtime=runsc

# The host's veto over a function's allowScripts opt-in. Off by default: the dependency
# install runs inside a gVisor sandbox like any other tenant code, so honouring the opt-in
# no longer costs a kernel boundary. Set to true to refuse those builds on this host.
RUNNER__DenyPrivateScriptsOnBuild=false

# --- Admission -----------------------------------------------------------------
# How many sandboxes run at once is discovered from this host, not set here: the runner reads
# its cgroup limits, what runs have actually peaked at, and the kernel's own pressure counters
# (/proc/pressure), then grows a slot at a time while nothing is stalling and gives a quarter of
# them back the moment memory does. Leave the line below commented out on every normal host.
# Uncomment it only to pin the number on a host where that measurement is known to be wrong —
# pinning stops the controller following the machine in either direction.
# RUNNER__MaxActiveSandboxes=10
#
# Host memory withheld from that arithmetic, for dockerd, the gVisor sentries and page cache.
# This one is a real knob: raise it on a host that runs anything besides the runner.
RUNNER__ReservedHostMemoryMb=2048

# --- What this runner consumes --------------------------------------------------
# Both default to true: a single-host install takes builds and runs alike, and adding a second
# host needs nothing here — runners share the work through the Redis consumer group.
#
# Split them once build volume is real. A build gets two CPUs and 2 GB for up to five minutes,
# and the admission controller above reads the pressure that creates and *shrinks run admission*
# while it lasts — correct behaviour, but it means one tenant's npm install throttles everyone
# else's runs on that host. Dedicating hosts keeps the two off each other:
#
#   run-only host:    RUNNER__ProcessBuilds=false
#   build-only host:  RUNNER__ProcessRuns=false
#
# Never set both to false — the runner would start, report healthy and consume nothing.
# RUNNER__ProcessRuns=true
# RUNNER__ProcessBuilds=true
RUNNER__LeaseMs=30000
RUNNER__HeartbeatMs=5000
RUNNER__MaxAttempts=3

# --- Egress ----------------------------------------------------------------------
# Informational only. The enforced list is /etc/blocks-runner/deny-cidrs, which
# provision/30-network.sh compiles into the nftables table; this line does not widen or
# narrow anything the firewall does.
RUNNER_DENY_CIDRS=
