# function.Dockerfile.tmpl — rendered by Blocks.FunctionRunner's BuildProcessor for each
# tenant build. Placeholders are substituted before the build; nothing here is evaluated by
# the runner itself.
#
#   {{BASE_IMAGE}}            pinned runtime, e.g. 127.0.0.1:5000/blocks/functions-node:24-v1@sha256:…
#   {{NPM_FLAGS}}             "--omit=dev --ignore-scripts" by default; the --ignore-scripts
#                             is dropped only when the function has allowScripts set
#   {{MAX_OLD_SPACE_MB}}      ~75 % of the run's memory ceiling, so V8 throws a catchable
#                             heap error before the cgroup OOM killer where it can
#   {{PACKAGES_BEGIN}}        per-build nonce markers fencing the resolved dependency list
#   {{PACKAGES_END}}          BuildProcessor reads back out of the build log
#
# Dependencies are resolved fresh from package.json on every build. No lockfile is accepted
# from the tenant and none is carried between builds: `npm ci` refuses to run without one and
# used to be skipped silently, which produced images with no node_modules at all that still
# reported SUCCEEDED and only failed at the first import. What was actually resolved is
# recorded on the build (the {{PACKAGES_BEGIN}} block below) rather than pinned in advance.
#
# The build runs with no platform credentials, on the same restricted egress network as a
# run, with its own CPU/memory/time budget (plan/PLAN-RUNNER-VM.md §A4).

FROM {{BASE_IMAGE}}

USER root
WORKDIR /function

# Manifest first: a source-only change reuses the dependency layer, which is what makes
# Test-then-Deploy cheap for the same content-addressed image (DECISIONS D3).
COPY manifest/ /function/

# Any lockfile is removed first: the BuildProcessor already keeps them out of the context, and
# one arriving another way would pin the install to versions the platform never screened.
RUN set -eux; \
    rm -f package-lock.json npm-shrinkwrap.json yarn.lock pnpm-lock.yaml; \
    npm install {{NPM_FLAGS}} --no-audit --no-fund; \
    npm cache clean --force >/dev/null 2>&1 || true

# What npm actually resolved, for the build record. This is deliberately a separate step from
# the install: the install layer above is meant to cache on the manifest, and a cached layer
# prints nothing, so folding this into it would leave every rebuild of an unchanged manifest
# with no idea what its own image contains. The markers carry this build's nonce, which makes
# the command text unique and the layer always run — and means nothing else in the log,
# including output from lifecycle scripts when a function opts into them, can pose as this
# block. `npm ls` exits non-zero on any tree warning, hence the `|| true`.
RUN set -eu; \
    echo "{{PACKAGES_BEGIN}}"; \
    npm ls --omit=dev --depth=0 --json 2>/dev/null || true; \
    echo "{{PACKAGES_END}}"

# Tenant source. Copied after the install so it never invalidates the dependency layer.
COPY src/ /function/

# Everything the function needs is readable and nothing is writable, by anyone. The rootfs
# is read-only at run time too; this makes the image correct on its own terms.
RUN set -eux; \
    chown -R root:root /function; \
    chmod -R a-w,a+rX /function; \
    test -f /function/index.js || { echo "index.js is missing from the function source" >&2; exit 1; }

ENV NODE_OPTIONS=--max-old-space-size={{MAX_OLD_SPACE_MB}}

USER 10001:10001
ENTRYPOINT ["node", "/runtime/bootstrap.mjs"]
